# ===== TribeFit Environment Configuration =====
# Copy this file to .env and replace placeholder values with your actual credentials

# ===== App Configuration =====
APP_NAME=TribeFit
APP_DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fr,ja

# ===== Next.js Configuration =====
NEXT_PUBLIC_BASE_URL=https://your-domain.com
CORS_ORIGINS=*

# ===== Supabase Database =====
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ===== Emergent LLM (AI Features) =====
# Get from your Emergent dashboard
EMERGENT_LLM_KEY=sk-emergent-your-key-here

# ===== Stripe Payments =====
# Get these from: https://dashboard.stripe.com/apikeys
# Use test keys for development, live keys for production
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===== Feature Flags =====
FEATURE_SNITCH_MODE=true
FEATURE_PACT_WALLET=true
FEATURE_COACH_MARKETPLACE=true

# ===== Security =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# ===== TribeCoins Configuration =====
COIN_USD_PEG=1.0
SKIP_FEE_TC=100
TOPUP_PACKS_TC=100,500,1000

# ===== Optional Services =====
# AdMob (for ads)
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_REWARDED_UNIT_ID=ca-app-pub-3940256099942544/5224354917

# Push Notifications
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_SENDER_ID=your_fcm_sender_id_here

# Analytics & Monitoring
SENTRY_DSN=https://your-sentry-dsn-here
ANALYTICS_ID=your-analytics-id-here

# ===== Development Only =====
# These are only needed for local development
WEBHOOK_SECRET=your-webhook-verification-secret